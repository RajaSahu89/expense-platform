# Neon (https://neon.tech) — copy this file to `.env` and fill in your own values.
# Pooled connection string (host contains "-pooler"), used by the running app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection string (same host, WITHOUT "-pooler"), used by Prisma migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Optional: protects the daily cron endpoint on Vercel (GET /api/recurring/generate).
# CRON_SECRET="a-long-random-string"
